+      "reason": "Remote rows are server-ordered; client row reorder cannot be committed as the authoritative data order."
+    },
+    {
+      "features": [
+        "group-header"
+      ],
+      "status": "unsupported",
+      "reason": "Nested/group header geometry is not implemented by the current single-row header renderer."
