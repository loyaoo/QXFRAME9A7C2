diff --git a/tools/verify-browser-smoke.js b/tools/verify-browser-smoke.js
new file mode 100644
index 0000000..b76d4c2
--- /dev/null
+++ b/tools/verify-browser-smoke.js
@@ -0,0 +1,30 @@
+'use strict';
+const fs=require('fs');
+const path=require('path');
+const cp=require('child_process');
+const root=path.resolve(__dirname,'..');
+const required=process.env.QX_BROWSER_REQUIRED==='1';
+const candidates=[process.env.CHROMIUM_BIN,'/usr/bin/chromium','/usr/bin/chromium-browser','/usr/bin/google-chrome','/usr/bin/google-chrome-stable'].filter(Boolean);
+const browser=candidates.find(p=>fs.existsSync(p));
+function skipped(reason){
+  const payload={ok:!required,skipped:true,required:required,reason:reason,browser:browser||null};
+  console.log(JSON.stringify(payload));
+  process.exit(required?1:0);
+}
+if(!browser) skipped('Chromium/Chrome executable not found');
+const html='file://'+path.join(root,'tools','verify-browser-smoke.html');
+const run=cp.spawnSync(browser,['--headless=new','--no-sandbox','--disable-gpu','--disable-dev-shm-usage','--no-first-run','--no-default-browser-check','--allow-file-access-from-files','--virtual-time-budget=2500','--dump-dom',html],{encoding:'utf8',maxBuffer:10*1024*1024,timeout:10000,killSignal:'SIGKILL'});
+if(run.error){
+  if(run.error.code==='ETIMEDOUT') skipped('Chromium headless launch/dump-dom timed out in this environment');
+  skipped('Chromium launch failed: '+run.error.message);
+}
+if(run.status!==0) skipped('Chromium exited with status '+run.status+': '+String(run.stderr||'').trim().slice(-1000));
+const output=String(run.stdout||'');
+const match=output.match(/QX_BROWSER_SMOKE:(\{[\s\S]*?\})<\/pre>/);
+if(!match) skipped('Browser smoke result marker not found in dump-dom output');
+let payload;
+try{payload=JSON.parse(match[1].replace(/&quot;/g,'"').replace(/&amp;/g,'&'));}
+catch(error){console.error('Invalid browser smoke payload:',match[1]);process.exit(1);}
+payload.browser=browser;payload.skipped=false;
+console.log(JSON.stringify(payload));
+if(!payload.ok)process.exit(1);
diff --git a/tools/verify-platform.js b/tools/verify-platform.js
new file mode 100644
index 0000000..8348a2d
--- /dev/null
+++ b/tools/verify-platform.js
@@ -0,0 +1,55 @@
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+
+const root = path.resolve(__dirname, '..');
+const kernelPath = path.join(root, 'src', 'qxframe9a7c2.js');
+const modulesRoot = path.join(root, 'src', 'modules');
+const supportPath = path.join(root, 'docs', 'browser-support.md');
+function assert(value, message) { if (!value) throw new Error(message); }
+
+assert(fs.existsSync(supportPath), 'Missing docs/browser-support.md.');
+const support = fs.readFileSync(supportPath, 'utf8');
+[
+  ['Chrome', '105'], ['Edge (Chromium)', '105'], ['Firefox', '112'], ['Safari', '16.4']
+].forEach(([browser, version]) => assert(support.includes(`| ${browser} | ${version} |`), `Browser baseline drift: ${browser} ${version}.`));
+for (const capability of ['AbortController','Pointer Events','ResizeObserver','MutationObserver','IntersectionObserver','`inert`','WeakRef','Trusted Types','Shadow DOM']) {
+  assert(support.includes(capability), `Browser support contract is missing capability: ${capability}.`);
+}
+assert(/Trusted Types[^\n]*\*\*not\*\* part of the 2\.19\.x baseline contract/.test(support), 'Trusted Types boundary must remain explicit instead of implying partial strict-CSP support.');
+assert(/Shadow DOM[^\n]*Not a formal 2\.19\.x framework contract/.test(support), 'Shadow DOM boundary must remain explicit; do not imply composed-tree support without a full contract.');
+assert(/ordinary Document DOM remains the supported ownership model/.test(support), 'Document DOM ownership boundary is missing.');
+
+const kernel = fs.readFileSync(kernelPath, 'utf8');
+const moduleFiles = fs.readdirSync(modulesRoot).filter(name => name.endsWith('.js')).sort();
+const modules = moduleFiles.map(name => ({ name, text: fs.readFileSync(path.join(modulesRoot, name), 'utf8') }));
+
+// Realm-sensitive DOM construction in instance modules must use the resolved document.
+const globalDocumentCreators = modules.filter(record => /\bglobal\.document\.(?:createElement|createElementNS|createDocumentFragment|createTextNode)\s*\(/.test(record.text));
+assert(globalDocumentCreators.length === 0, `Visible modules create DOM through global.document: ${globalDocumentCreators.map(x => x.name).join(', ')}.`);
+
+// Observer constructors belong to ObserverHub. Merely testing constructor availability is allowed;
+// constructing an observer in a visible module is not.
+const directObservers = modules.filter(record => /new\s+(?:ResizeObserver|MutationObserver|IntersectionObserver)\s*\(/.test(record.text));
+assert(directObservers.length === 0, `Visible modules construct platform observers directly: ${directObservers.map(x => x.name).join(', ')}.`);
+assert(kernel.includes("registry.define('ObserverHub'"), 'ObserverHub canonical platform boundary is missing.');
+assert(/typeof Ctor !== 'function'/.test(kernel), 'ObserverHub must fail closed when a platform observer constructor is unavailable.');
+
+// Async/motion lifecycle must not require AbortController to exist.
+assert(/opts\.AbortController \|\| global\.AbortController/.test(kernel), 'AsyncTask AbortController boundary is missing.');
+assert(/typeof global\.AbortController === 'function'/.test(kernel), 'MotionCore AbortController fallback guard is missing.');
+assert(/typeof WeakRef === 'function'/.test(kernel), 'WeakRef must remain optional diagnostics-only functionality.');
+
+// Interaction isolation must retain a no-inert fallback.
+assert(/!\('inert' in node\) && node\.style/.test(kernel), 'InteractionIsolation inert fallback is missing.');
+
+// Supported source may contain the framework static template boundary, but visible modules may not
+// introduce arbitrary innerHTML writes.
+const arbitraryInnerHTML = modules.filter(record => /\.innerHTML\s*=/.test(record.text));
+assert(arbitraryInnerHTML.length === 0, `Visible modules write innerHTML directly: ${arbitraryInnerHTML.map(x => x.name).join(', ')}.`);
+assert(kernel.includes("registry.define('DOMTemplate'"), 'DOMTemplate static markup boundary is missing.');
+assert(/DOMTemplate\.staticHTML forbids JavaScript interpolation/.test(kernel), 'DOMTemplate must remain static-only while strict Trusted Types is outside the baseline.');
+assert(/template\.innerHTML = markup/.test(kernel), 'DOMTemplate implementation changed; revisit the Trusted Types boundary before claiming strict-CSP support.');
+
+console.log(JSON.stringify({ ok: true, browserBaseline: { chrome: 105, edge: 105, firefox: 112, safari: '16.4' }, modules: moduleFiles.length }));
diff --git a/tools/verify-release.js b/tools/verify-release.js
new file mode 100644
index 0000000..871ed6f
--- /dev/null
+++ b/tools/verify-release.js
@@ -0,0 +1,143 @@
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+const crypto = require('crypto');
+
+const root = path.resolve(__dirname, '..');
+const src = path.join(root, 'src');
+const dist = path.join(root, 'dist');
+const docs = path.join(root, 'docs');
+const modulesDir = path.join(src, 'modules');
+
+function assert(value, message) { if (!value) throw new Error(message); }
+function read(file) { return fs.readFileSync(file, 'utf8'); }
+function walk(dir, predicate, output = []) {
+  if (!fs.existsSync(dir)) return output;
+  for (const name of fs.readdirSync(dir).sort()) {
+    const file = path.join(dir, name);
+    const stat = fs.statSync(file);
+    if (stat.isDirectory()) walk(file, predicate, output);
+    else if (!predicate || predicate(file)) output.push(file);
+  }
+  return output;
+}
+function rel(file) { return path.relative(root, file).replace(/\\/g, '/'); }
+function sha(file) { return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex'); }
+
+// 1) Every shipped/generated JS source must parse without execution.
+const jsFiles = [
+  ...walk(src, file => file.endsWith('.js')),
+  ...walk(path.join(root, 'tools'), file => file.endsWith('.js')),
+  ...walk(path.join(docs, 'assets'), file => file.endsWith('.js')),
+  path.join(dist, 'qxframe9a7c2.js')
+].filter((file, index, list) => list.indexOf(file) === index);
+for (const file of jsFiles) {
+  try { new vm.Script(read(file), { filename: rel(file) }); }
+  catch (error) { throw new Error(`JavaScript syntax check failed: ${rel(file)}\n${error.message}`); }
+}
+
+// 2) Every project JSON artifact must parse.
+const jsonFiles = [
+  ...walk(path.join(src, 'manifests'), file => file.endsWith('.json')),
+  ...walk(path.join(docs, 'generated'), file => file.endsWith('.json')),
+  ...walk(dist, file => file.endsWith('.json')),
+  path.join(root, 'package.json')
+].filter((file, index, list) => list.indexOf(file) === index);
+for (const file of jsonFiles) {
+  try { JSON.parse(read(file)); }
+  catch (error) { throw new Error(`JSON syntax check failed: ${rel(file)}\n${error.message}`); }
+}
+
+// 3) No unresolved merge/conflict markers in authored or generated text.
+const conflictRoots = [src, path.join(root, 'tools'), docs, path.join(root, 'README.md')];
+const textExtensions = new Set(['.js','.json','.css','.html','.md','.txt','.d.ts']);
+const textFiles = [];
+for (const target of conflictRoots) {
+  if (!fs.existsSync(target)) continue;
+  if (fs.statSync(target).isDirectory()) walk(target, file => textExtensions.has(path.extname(file)) || file.endsWith('.d.ts'), textFiles);
+  else textFiles.push(target);
+}
+const conflictOffenders = textFiles.filter(file => /^(?:<{7}|={7}|>{7})(?:\s|$)/m.test(read(file)));
+assert(conflictOffenders.length === 0, `Unresolved merge-conflict marker(s): ${conflictOffenders.map(rel).join(', ')}`);
+
+// 4) Reconstruct the JS bundle exactly from current src. This proves src/dist consistency,
+// not merely that dist happened to exist from an older build.
+const kernel = read(path.join(src, 'qxframe9a7c2.js'));
+const moduleFiles = fs.readdirSync(modulesDir).filter(name => name.endsWith('.js')).sort();
+const moduleRecords = moduleFiles.map(file => {
+  const text = read(path.join(modulesDir, file));
+  const match = text.match(/defineModule\(\s*\{\s*name\s*:\s*['"]([^'"]+)['"]/);
+  assert(match, `Unable to parse module name for release consistency: src/modules/${file}`);
+  return { file, text, name: match[1] };
+});
+let expectedBundle = kernel + '\n';
+for (const record of moduleRecords) expectedBundle += `\n/* bundled: src/modules/${record.file} */\n${record.text}\n`;
+expectedBundle += `\n(function(global){\n  'use strict';\n  global.QXFRAME9A7C2.__bootstrapBundled(${JSON.stringify(moduleRecords.map(record => record.name))});\n})(typeof globalThis !== 'undefined' ? globalThis : this);\n`;
+assert(read(path.join(dist, 'qxframe9a7c2.js')) === expectedBundle, 'dist/qxframe9a7c2.js is not the exact bundle of the current src tree. Run npm run build.');
+
+// 5) Reconstruct CSS from its physical source-order manifest and require src aggregate + dist exact equality.
+const cssOrder = JSON.parse(read(path.join(src, 'manifests', 'css-order.json')));
+assert(Array.isArray(cssOrder.files) && cssOrder.files.length === 11, 'CSS release source order must contain stages 00-10.');
+const expectedCss = cssOrder.files.map(entry => read(path.join(src, 'css', entry.file)).replace(/\s+$/, '')).join('\n\n') + '\n';
+assert(read(path.join(src, 'qxframe9a7c2.css')) === expectedCss, 'src/qxframe9a7c2.css does not match canonical CSS fragments/source order.');
+assert(read(path.join(dist, 'qxframe9a7c2.css')) === expectedCss, 'dist/qxframe9a7c2.css does not match canonical CSS source. Run npm run build.');
+
+// 6) Generated API/migration/module manifests must be exact mirrors across dist/docs.
+for (const [distName, docsName] of [
+  ['qxframe9a7c2-api.json','component-api.json'],
+  ['qxframe9a7c2-migration.json','migration-manifest.json'],
+  ['qxframe9a7c2-module-manifest.json','module-manifest.json']
+]) {
+  assert(read(path.join(dist, distName)) === read(path.join(docs, 'generated', docsName)), `${distName} and docs/generated/${docsName} drifted.`);
+}
+
+// 7) Required release artifacts must be present and non-empty.
+const required = [
+  'dist/qxframe9a7c2.js','dist/qxframe9a7c2.css','dist/qxframe9a7c2.d.ts','dist/qxframe9a7c2-api.json',
+  'dist/qxframe9a7c2-migration.json','dist/qxframe9a7c2-module-manifest.json',
+  'docs/generated/canonical-system-manifest.json','docs/generated/state-ownership.json',
+  'docs/generated/table-feature-matrix.json','docs/generated/framework-feature-combinations.json',
+  'docs/generated/css-exceptions.json','docs/generated/css-source-order.json'
+];
+for (const name of required) {
+  const file = path.join(root, name);
+  assert(fs.existsSync(file) && fs.statSync(file).size > 0, `Missing/empty release artifact: ${name}`);
+}
+
+// 8) Font payload is a generated mirror when fonts are present.
+const srcFonts = path.join(src, 'fonts');
+const distFonts = path.join(dist, 'fonts');
+if (fs.existsSync(srcFonts)) {
+  const sourceFontFiles = walk(srcFonts, () => true).map(file => path.relative(srcFonts, file)).sort();
+  const distFontFiles = walk(distFonts, () => true).map(file => path.relative(distFonts, file)).sort();
+  assert(JSON.stringify(sourceFontFiles) === JSON.stringify(distFontFiles), 'dist/fonts file list does not match src/fonts.');
+  sourceFontFiles.forEach(name => assert(sha(path.join(srcFonts, name)) === sha(path.join(distFonts, name)), `Font mirror drifted: ${name}`));
+}
+
+// 9) Final zero-consumer guards across authored source/docs (inventory manifests may mention history).
+const moduleText = moduleFiles.map(file => read(path.join(modulesDir, file))).join('\n');
+const zeroPatterns = [
+  [/global\.getComputedStyle\s*\(/, 'global.getComputedStyle'],
+  [/global\.document\.(?:createElement|createTextNode|createDocumentFragment)\s*\(/, 'global.document DOM creation'],
+  [/(?:ComponentDOMFactories|BuildingBlockDOMFactories|CSSCompatState|qxframe9a7c2-rel-)/, 'deleted bridge/rel runtime'],
+  [/(?:requestId\s*\+\+|loadGeneration|datasetGeneration)/, 'manual async generation'],
+  [/(?:SortablePointer|DragSorter|TableDragController|UploadSorter)/, 'parallel reorder implementation'],
+  [/keepFilterPopup/, 'Table scenario-specific render flag']
+];
+for (const [pattern, label] of zeroPatterns) assert(!pattern.test(moduleText), `Release zero-consumer guard failed: ${label}.`);
+
+const packageJson = JSON.parse(read(path.join(root, 'package.json')));
+const api = JSON.parse(read(path.join(dist, 'qxframe9a7c2-api.json')));
+assert(api.version === packageJson.version, `Generated API version ${api.version} != package version ${packageJson.version}.`);
+
+process.stdout.write(JSON.stringify({
+  ok: true,
+  jsSyntaxFiles: jsFiles.length,
+  jsonFiles: jsonFiles.length,
+  modules: moduleRecords.length,
+  cssStages: cssOrder.files.length,
+  bundleSha256: sha(path.join(dist, 'qxframe9a7c2.js')),
+  cssSha256: sha(path.join(dist, 'qxframe9a7c2.css'))
+}) + '\n');
