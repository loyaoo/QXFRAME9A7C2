+{
+  "version": 1,
+  "policy": "Compatibility is a one-way Legacy -> Canonical adapter or rejection boundary. Canonical runtime/CSS must not consume these legacy contracts.",
+  "defaults": {
+    "option": {
+      "since": "pre-fix11",
+      "deprecatedSince": "2.19.81",
+      "removedIn": "3.0.0",
+      "replacement": "Use the canonical option documented by ComponentRuntime OptionSchema.",
+      "migrationNote": "Legacy option names are rejected at the Runtime Schema boundary; migrate callers to the canonical component option before upgrading."
+    }
+  },
+  "entries": [
+    {
+      "kind": "class",
+      "name": "qxframe9a7c2-theme-light",
+      "status": "adapter",
+      "since": "pre-fix11",
+      "deprecatedSince": "2.19.81",
+      "removedIn": "3.0.0",
+      "replacement": "[data-qxframe9a7c2-theme=\"light\"]",
+      "migrationNote": "Config reads the legacy class once, projects the canonical data attribute, then removes the class."
+    },
+    {
+      "kind": "class",
+      "name": "qxframe9a7c2-theme-dark",
+      "status": "adapter",
+      "since": "pre-fix11",
+      "deprecatedSince": "2.19.81",
+      "removedIn": "3.0.0",
+      "replacement": "[data-qxframe9a7c2-theme=\"dark\"]",
+      "migrationNote": "Config reads the legacy class once, projects the canonical data attribute, then removes the class."
+    },
+    {
+      "kind": "bridge",
+      "name": "ComponentDOMFactories",
+      "status": "removed",
+      "since": "legacy",
+      "deprecatedSince": "2.19.81",
+      "removedIn": "fix11",
+      "replacement": "module-local component DOM factory",
+      "migrationNote": "The global bridge was deleted; component modules now own their DOM factory directly."
+    },
+    {
+      "kind": "bridge",
+      "name": "BuildingBlockDOMFactories",
+      "status": "removed",
+      "since": "legacy",
+      "deprecatedSince": "2.19.81",
+      "removedIn": "fix11",
+      "replacement": "module-local building-block DOM factory",
+      "migrationNote": "The global bridge was deleted; building-block modules now own their DOM factory directly."
+    },
+    {
+      "kind": "state-class-family",
+      "name": "qxframe9a7c2-rel-*",
+      "status": "removed",
+      "since": "legacy",
+      "deprecatedSince": "2.19.81",
