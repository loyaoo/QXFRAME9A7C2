+const AsyncTask = qx.HeadlessRegistry.get('AsyncTask');
+const AsyncAction = qx.HeadlessRegistry.get('AsyncAction');
+let asyncActionFirstCalls = 0, asyncActionFreshCalls = 0, asyncActionStateErrors = 0;
+const asyncAction = AsyncAction.create({
+  action() { asyncActionFirstCalls += 1; return 1; },
+  onStateChange() { asyncActionStateErrors += 1; throw new Error('verify async action callback isolation'); },
+  onError() {}
+});
+asyncAction.updateOptions({ action() { asyncActionFreshCalls += 1; return 2; } });
+asyncAction.run(null, { source: 'verify' }).catch(() => {});
+assert(asyncActionFirstCalls === 0 && asyncActionFreshCalls === 1, 'AsyncAction.updateOptions must use the latest action callback.');
+assert(asyncAction.snapshot().pending === true, 'AsyncAction must enter pending synchronously before Promise settlement.');
+assert(asyncActionStateErrors >= 1, 'AsyncAction state callback isolation regression did not execute.');
+asyncAction.destroy();
+assert(asyncAction.snapshot().state === 'destroyed' && asyncAction.snapshot().pending === false, 'AsyncAction destroy must synchronously enter destroyed/non-pending state.');
+const FocusScope = qx.DOMHeadlessRegistry.get('FocusScope');
+const ScrollLock = qx.DOMHeadlessRegistry.get('ScrollLock');
+const InteractionIsolation = qx.DOMHeadlessRegistry.get('InteractionIsolation');
+const resourceListeners = Object.create(null);
+const resourceDoc = {
+  nodeType: 9,
+  activeElement: null,
+  addEventListener(type, handler) { (resourceListeners[type] || (resourceListeners[type] = [])).push(handler); },
+  removeEventListener(type, handler) { const list = resourceListeners[type] || []; const index = list.indexOf(handler); if (index >= 0) list.splice(index, 1); }
+};
+const resourceRoot = {
+  nodeType: 1,
+  ownerDocument: resourceDoc,
+  children: [],
+  contains(node) { return node === this; },
+  querySelectorAll() { return []; }
+};
+resourceDoc.documentElement = resourceRoot;
+resourceDoc.body = { nodeType: 1, ownerDocument: resourceDoc, children: [], contains() { return false; } };
+const fakeFocusManager = {
+  capture() { return null; }, restore() { return false; }, focus() { return false; },
+  isTabbable() { return false; }, tabbable() { return []; }
+};
+function makeScrollTarget() {
+  const values = { overflow: 'auto', 'padding-inline-end': '' };
+  const style = {
+    get overflow() { return values.overflow || ''; }, set overflow(value) { values.overflow = String(value == null ? '' : value); },
+    get paddingInlineEnd() { return values['padding-inline-end'] || ''; }, set paddingInlineEnd(value) { values['padding-inline-end'] = String(value == null ? '' : value); },
+    getPropertyValue(name) { return values[String(name)] || ''; },
+    getPropertyPriority() { return ''; },
+    setProperty(name, value) { values[String(name)] = String(value); },
+    removeProperty(name) { delete values[String(name)]; }
+  };
+  return { nodeType: 1, offsetWidth: 100, clientWidth: 100, style };
+}
+const ownershipScrollTarget = makeScrollTarget();
+const ownershipScroll = ScrollLock.create({ target: ownershipScrollTarget, document: { documentElement: ownershipScrollTarget, body: ownershipScrollTarget }, window: {}, compensateScrollbar: false });
+ownershipScroll.lock();
+assert(ownershipScrollTarget.style.overflow === 'hidden', 'ScrollLock must project overflow while active.');
+ownershipScrollTarget.style.overflow = 'clip';
+ownershipScroll.unlock();
+assert(ownershipScrollTarget.style.overflow === 'clip', 'ScrollLock must not restore over an external DOM write that took ownership after QX.');
+ownershipScroll.destroy();
+
+const stressBefore = Diagnostics.snapshot('resource-stress-before');
+for (let i = 0; i < 100; i += 1) {
+  const lifecycleScope = Lifecycle.createScope();
+  let released = 0;
+  lifecycleScope.add(function () { released += 1; });
+  lifecycleScope.dispose();
+  assert(released === 1, 'Lifecycle resource cleanup must execute exactly once.');
+
+  const stressLease = DOMProjection.create();
+  const stressNode = fakeProjectedNode();
+  stressLease.setAttribute(stressNode, 'data-stress', String(i));
+  stressLease.setClass(stressNode, 'is-stress', true);
+  stressLease.destroy();
+
+  const stressTask = AsyncTask.create({ task() { return i; } });
+  stressTask.destroy();
+  const stressAction = AsyncAction.create({ action() { return i; } });
+  stressAction.destroy();
+
+  const stressObserverStop = ObserverHub.resize(observerTarget, function () {}, { schedule: false });
+  stressObserverStop();
+
+  const stressLayerManager = LayerManager.create({ baseZIndex: 3000 });
+  stressLayerManager.register(null, { id: 'stress-layer-' + i, kind: 'popup' });
+  stressLayerManager.destroy();
+
+  const stressFocus = FocusScope.create({ root: resourceRoot, document: resourceDoc, focusManager: fakeFocusManager, mode: 'exit', captureFocus: false, restoreFocus: false });
+  stressFocus.activate();
+  stressFocus.destroy();
+
+  const scrollTarget = makeScrollTarget();
+  const stressScroll = ScrollLock.create({ target: scrollTarget, document: { documentElement: scrollTarget, body: scrollTarget }, window: {}, compensateScrollbar: false });
+  stressScroll.lock();
+  stressScroll.destroy();
+  assert(scrollTarget.style.overflow === 'auto', 'ScrollLock must restore authored overflow after destroy.');
+
+  const stressIsolation = InteractionIsolation.create({ root: resourceRoot, document: resourceDoc, boundary: resourceDoc.body, observe: false });
+  stressIsolation.activate();
+  stressIsolation.destroy();
+
+  const stressMotion = MotionCore.create({ element: motionElement, motion: { enter: {}, leave: {} }, appear: false, visible: false });
+  stressMotion.destroy();
+}
+flushAnimationFrames();
+const stressAfter = Diagnostics.snapshot('resource-stress-after');
+Diagnostics.assertBalanced(stressBefore, stressAfter);
+assert(Object.values(resourceListeners).every(list => list.length === 0), 'Repeated FocusScope cycles must release all document listeners.');
+
